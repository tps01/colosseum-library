# Fill resources and models using the qualified bench layout.
[io.i2c]
i2c_id = 1
driver = "totalphase-aardvark"
resource = "FILL_IN_HERE"
pullup = false
target_power = false

[io.analyzer]
analyzer_id = 1
driver = "totalphase-beagle"
model = "i2c-spi"
protocol = "i2c"
resource = "FILL_IN_HERE"
pullup = false
target_power = false
