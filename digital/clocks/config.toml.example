# SIMULATION DEFAULT: generated responses are not DUT evidence.
# Change the driver AND endpoint for live use; changing resource alone keeps sim.
# Live setup and required rows: ../../docs/bench_modes.md
[equipment.oscope]
oscope_id = 1
driver = sim
resource = SIM::SCOPE1

[equipment.freqcounter]
freqcounter_id = 1
driver = sim
resource = SIM::FC1
